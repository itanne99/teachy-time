{
  "name": "teachy-time",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "db:start": "supabase start --ignore-health-check",
    "db:stop": "supabase stop",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:push:local": "node scripts/db-run.js push",
    "db:diff": "supabase db diff -f",
    "db:list": "node scripts/db-run.js list",
    "db:reset": "supabase stop --no-backup && supabase start",
    "db:status": "supabase status"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^9.2.4",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "agentation-mcp": "^1.2.0",
    "bootstrap": "^5.3.8",
    "bootswatch": "^5.3.7",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-audio-player": "^0.17.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "^15.5.9",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "agentation": "^3.0.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-unicorn": "^65.0.1",
    "jsdom": "^30.1.0",
    "node-mocks-http": "^1.18.1",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
